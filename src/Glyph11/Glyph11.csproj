<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>

        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>

        <Description>Dependency free, low allocation HTTP/1.1 parser for C#.</Description>
        <PackageTags>C# HTTP Protocol Parser</PackageTags>

        <AssemblyVersion>0.3.7.0</AssemblyVersion>
        <FileVersion>0.3.7.0</FileVersion>
        <Version>0.3.7</Version>

        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <PackageProjectUrl>https://github.com/MDA2AV/Glyph11</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/MDA2AV/Glyph11</RepositoryUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>

        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Deterministic>true</Deterministic>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>

    </PropertyGroup>

    <ItemGroup>
        <!-- Kept although Glyph11.Pico is no longer built here. The already-published
             Glyph11.Pico 0.0.1 (used alongside Glyph11, e.g. by GenHTTP) sets BinaryRequest's
             internal setters and calls the internal KeyValueList.Add, and the runtime enforces friend
             access: without this attribute those calls fail with MethodAccessException as soon
             as Pico runs against a newer Glyph11. Remove it once Pico 0.0.1 has no users. -->
        <InternalsVisibleTo Include="Glyph11.Pico" />
    </ItemGroup>

</Project>
